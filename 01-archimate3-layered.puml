@startuml
!pragma layout smetana
title S3-Platform — ArchiMate 3 Layered View (As-Is)

' ==== BUSINESS LAYER ====
package "Business Layer" <<Rectangle>> {
  archimate #Business "Plugin Author"        as author    <<business-actor>>
  archimate #Business "Annotation Expert"    as expert    <<business-actor>>
  archimate #Business "Platform Operator"    as operator  <<business-actor>>

  archimate #Business "Source Ingestion"     as svc_ingest <<business-service>>
  archimate #Business "Document Annotation"  as svc_annot  <<business-service>>
  archimate #Business "Plugin Distribution"  as svc_plugin <<business-service>>
}

' ==== APPLICATION LAYER ====
package "Application Layer" <<Rectangle>> {
  archimate #Application "s3p-sdk\n(Python lib)"                  as sdk         <<application-component>>
  archimate #Application "s3p-node\n(worker)"                     as node        <<application-component>>
  archimate #Application "s3p-n8n\n(workflow host)"               as n8n         <<application-component>>
  archimate #Application "s3p-simple-api\n(n8n shim)"             as simple_api  <<application-component>>
  archimate #Application "s3p-tape-service\n(REST + WS + worker)" as tape        <<application-component>>
  archimate #Application "s3p-web-annotation\n(SPA)"              as web         <<application-component>>
  archimate #Application "s3p-database\n(SQL + DB functions)"     as db_app      <<application-component>>
  archimate #Application "cloud-core\n(Helm + ArgoCD)"            as cloud       <<application-component>>
  archimate #Application "plugin-template\n(GitHub scaffold)"     as plugin_tpl  <<application-component>>
  archimate #Application "GitHub Actions\n(CI)"                   as gha         <<application-component>>

  archimate #Application "S3PTask"                                as do_task     <<application-data-object>>
  archimate #Application "S3PDocument"                            as do_doc      <<application-data-object>>
  archimate #Application "S3PScore"                               as do_score    <<application-data-object>>
  archimate #Application "Plugin artifact\n(plugin.xml + src/*)"  as do_plugin   <<application-data-object>>
}

' ==== TECHNOLOGY LAYER ====
package "Technology Layer" <<Rectangle>> {
  archimate #Technology "Kubernetes\ndemo-s3p-dev"         as k8s       <<technology-node>>
  archimate #Technology "Compose host\n(n8n stack)"        as host_n8n  <<technology-node>>
  archimate #Technology "VM\n(tape-service)"               as host_tape <<technology-node>>
  archimate #Technology "Static hosting\n(Timeweb / nginx)" as static    <<technology-node>>
  archimate #Technology "Postgres host"                    as host_db   <<technology-node>>

  archimate #Technology "PostgreSQL 16"                    as pg        <<technology-system-software>>
  archimate #Technology "Redis"                            as redis     <<technology-system-software>>
  archimate #Technology "S3 bucket\n(plugin artifacts)"    as s3        <<technology-artifact>>
  archimate #Technology "GHCR\n(container registry)"       as ghcr      <<technology-artifact>>
  archimate #Technology "GitHub\n(SCM + Actions)"          as gh        <<technology-service>>
}

' ==== BUSINESS: actors -> services ====
author    --> svc_plugin
expert    --> svc_annot
operator  --> svc_ingest

' ==== APPLICATION REALIZES BUSINESS ====
n8n         ..|> svc_ingest
node        ..|> svc_ingest
simple_api  ..|> svc_ingest
web         ..|> svc_annot
tape        ..|> svc_annot
plugin_tpl  ..|> svc_plugin
gha         ..|> svc_plugin

' ==== APP <-> APP ====
sdk         <-- node       : uses
sdk         <-- tape       : uses
simple_api  <-- n8n        : uses
db_app      <-- simple_api : SQL
db_app      <-- node       : SQL
db_app      <-- tape       : SQL
tape        <-- web        : REST + WS

node        --> do_task    : reads
node        --> do_plugin  : downloads
node        --> do_doc     : writes
tape        --> do_score   : writes
tape        --> do_doc     : reads
gha         --> do_plugin  : produces

' ==== APP DEPLOYED ON TECH ====
node       --> k8s        : assigned to
n8n        --> host_n8n   : assigned to
simple_api --> host_n8n   : assigned to
tape       --> host_tape  : assigned to
web        --> static     : assigned to
db_app     --> pg         : realized by
pg         --> host_db    : assigned to
tape       --> redis      : uses
node       --> s3         : uses
gha        --> s3         : uses
k8s        --> ghcr       : pulls
author     --> gh         : pushes to
gha        --> gh         : runs on
cloud      --> k8s        : manages

@enduml
